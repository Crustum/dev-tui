{
    "name": "@crustum/dev-tui",
    "version": "0.1.0",
    "description": "OpenTUI dev process runner — tabbed TUI for running multiple commands simultaneously (dev-tui, port of multiplex)",
    "keywords": [
        "tui",
        "terminal",
        "cli",
        "multiplexer",
        "process-manager",
        "opentui",
        "windows",
        "cakephp"
    ],
    "license": "MIT",
    "type": "module",
    "bin": {
        "dev-tui": "dist/cli.js"
    },
    "main": "dist/devTui.js",
    "types": "dist/devTui.d.ts",
    "exports": {
        ".": {
            "types": "./dist/devTui.d.ts",
            "default": "./dist/devTui.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "bun src/cli.ts",
        "dev:node": "node --import tsx src/cli.ts",
        "build": "tsc",
        "test": "tsx --test src/proc/*.test.ts src/tui/*.test.ts",
        "test:bun": "bun test",
        "test:all": "tsx --test src/proc/*.test.ts src/tui/*.test.ts && bun test src/ui/",
        "check": "biome check --write",
        "lint": "biome lint",
        "format": "biome format --write"
    },
    "dependencies": {
        "@opentui/core": "0.5.11",
        "ansi-styles": "^7.0.0",
        "commander": "^15.0.0",
        "string-width": "^8.2.2",
        "wrap-ansi": "^10.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@types/bun": "1.4.1",
        "@types/node": "^26.1.1",
        "tsx": "^4.23.5",
        "typescript": "^7.0.2"
    },
    "publishConfig": {
        "access": "public"
    },
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "engines": {
        "bun": ">=1.3.0",
        "node": ">=26.4.0"
    }
}
