{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "outDir": "dist",
        "rootDir": "src",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node", "bun"],
        "declaration": true,
        "sourceMap": true,
        "resolveJsonModule": true
    },
    "include": ["src"],
    "exclude": ["src/*.test.ts", "src/**/*.test.ts"]
}
